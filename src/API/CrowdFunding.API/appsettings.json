{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=crowdfundingdb;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "CrowdFunding.API",
    "Audience": "CrowdFunding.Client",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenMeter": {
    "BaseUrl": "https://openmeter.cloud",
    "ApiKey": null
  },
  "Metering": {
    "Fees": {
      "PlatformFeeBps": 500,
      "ProcessingFeeFixedCents": 30,
      "ProcessingFeeBps": 290
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
